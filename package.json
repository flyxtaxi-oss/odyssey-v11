{
  "name": "odyssey",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:emulator": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 NEXT_PUBLIC_FIREBASE_PROJECT_ID=jarvis-53b7c next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "emulator": "PATH=\"${JAVA_HOME:-$(brew --prefix openjdk 2>/dev/null)}/bin:$PATH\" firebase emulators:start --only firestore,auth",
    "test:rules": "PATH=\"${JAVA_HOME:-$(brew --prefix openjdk 2>/dev/null)}/bin:$PATH\" firebase emulators:exec --only firestore \"vitest run firestore-rules.emulator\"",
    "verify": "npm run typecheck && npm run lint && npm test",
    "verify:all": "npm run typecheck && npm run lint && npm test && npm run test:rules && npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.31",
    "@ai-sdk/openai-compatible": "^2.0.47",
    "@ai-sdk/react": "^3.0.107",
    "@sentry/nextjs": "^10.69.0",
    "ai": "^6.0.99",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.11.0",
    "firebase-admin": "^13.7.0",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.575.0",
    "next": "^16.2.12",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "firebase-tools": "^15.12.0",
    "husky": "^9.1.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
